    {
      "type": "table",
      "title": "Consultas mais caras (pg_stat_statements)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "geo-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "geo-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select round(total_exec_time::numeric, 1) as total_ms, calls, round(mean_exec_time::numeric, 2) as media_ms, rolname as papel, left(regexp_replace(query, '\\s+', ' ', 'g'), 160) as consulta\nfrom pg_stat_statements s join pg_roles r on r.oid = s.userid\nwhere s.dbid = (select oid from pg_database where datname = 'geo')\norder by total_exec_time desc limit 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "w": 24,
        "h": 10,
        "x": 0,
        "y": 12
      },
      "id": 7
    },
    {
      "type": "table",
      "title": "Consultas da biblioteca geoibge (papel api_reader)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "geo-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "geo-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select calls, round(mean_exec_time::numeric, 2) as media_ms, round(max_exec_time::numeric, 2) as max_ms, rows, left(regexp_replace(query, '\\s+', ' ', 'g'), 160) as consulta\nfrom pg_stat_statements s join pg_roles r on r.oid = s.userid\nwhere r.rolname = 'api_reader' and s.dbid = (select oid from pg_database where datname = 'geo')\norder by mean_exec_time * calls desc limit 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "w": 24,
